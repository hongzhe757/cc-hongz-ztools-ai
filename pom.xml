<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<packaging>jar</packaging>

	<parent>
		<groupId>cc.hongz</groupId>
		<artifactId>cc-hongz-ztools</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>cc-hongz-ztools-ai</artifactId>
	<name>${project.artifactId}</name>
	<description>AI模块（对齐 hutool-ai，LLM 调用封装：OpenAI/DeepSeek/Gemini/Grok/Ollama/豆包/Hutool）</description>

	<properties>
		<Automatic-Module-Name>cc.hongz.ztools.ai</Automatic-Module-Name>
	</properties>

	<dependencies>
		<!-- ztools 核心工具类库 -->
		<dependency>
			<groupId>cc.hongz</groupId>
			<artifactId>cc-hongz-ztools-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- ztools HTTP 客户端 -->
		<dependency>
			<groupId>cc.hongz</groupId>
			<artifactId>cc-hongz-ztools-http</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- ztools 日志门面 -->
		<dependency>
			<groupId>cc.hongz</groupId>
			<artifactId>cc-hongz-ztools-log</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- ztools JSON 序列化 -->
		<dependency>
			<groupId>cc.hongz</groupId>
			<artifactId>cc-hongz-ztools-json</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- JUnit5 测试框架 -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Lombok 测试去样板 -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
